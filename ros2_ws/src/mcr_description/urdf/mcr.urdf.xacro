<?xml version="1.0"?>
<!--
  Mecanum Mobile Robot (MCR) — URDF model.
  Usage: xacro mcr.urdf.xacro > mcr.urdf

  Wheel layout:
       FRONT (+x)
    M1(FL)   M2(FR)
    ┌──────────────┐
    │              │
    │   [LiDAR]    │   +y (left)
    │   [Camera]   │
    │              │
    └──────────────┘
    M3(RL)   M4(RR)
       REAR

  All wheels are mecanum type with rollers (±45°).
  The mecanum roller direction alternates per wheel for X-pattern.
-->
<robot name="mcr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- Parameters                                                    -->
  <!-- ============================================================ -->
  <xacro:property name="wheel_radius"   value="0.0325"/>  <!-- m -->
  <xacro:property name="wheel_width"    value="0.026"/>   <!-- m -->
  <xacro:property name="wheel_mass"     value="0.05"/>    <!-- kg -->

  <xacro:property name="lx"             value="0.10"/>    <!-- half wheelbase (m) -->
  <xacro:property name="ly"             value="0.12"/>    <!-- half track width (m) -->

  <xacro:property name="base_length"    value="0.26"/>    <!-- chassis length -->
  <xacro:property name="base_width"     value="0.22"/>    <!-- chassis width -->
  <xacro:property name="base_height"    value="0.06"/>    <!-- chassis thickness -->

  <xacro:property name="chassis_mass"   value="2.0"/>     <!-- kg (with Pi + battery) -->

  <xacro:property name="pi_offset_z"    value="0.04"/>    <!-- Pi board above chassis -->
  <xacro:property name="lidar_offset_z" value="0.10"/>    <!-- LiDAR height -->

  <!-- ============================================================ -->
  <!-- Materials                                                     -->
  <!-- ============================================================ -->
  <material name="chassis_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!-- Macros                                                        -->
  <!-- ============================================================ -->

  <!-- Mecanum wheel macro -->
  <xacro:macro name="mecanum_wheel"
               params="name x y parent
                       roller_angle:=0.785398">  <!-- ±45° = ±π/4 rad -->
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child  link="${name}_link"/>
      <origin xyz="${x} ${y} ${-wheel_radius}" rpy="0 0 0"/>
      <axis   xyz="0 1 0"/>  <!-- Wheel rotates about Y axis -->
      <dynamics damping="0.01" friction="0.1"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
          iyy="${wheel_mass * wheel_radius * wheel_radius}"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- Base / Chassis                                                -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * chassis_mass * (base_width*base_width + base_height*base_height)}"
        iyy="${(1.0/12.0) * chassis_mass * (base_length*base_length + base_height*base_height)}"
        izz="${(1.0/12.0) * chassis_mass * (base_length*base_length + base_width*base_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ============================================================ -->
  <!-- 4 Mecanum Wheels                                              -->
  <!-- ============================================================ -->
  <xacro:mecanum_wheel name="wheel_front_left"  parent="base_link"
                        x="${lx}"  y="${ly}"  roller_angle="${pi/4}"/>
  <xacro:mecanum_wheel name="wheel_front_right" parent="base_link"
                        x="${lx}"  y="${-ly}" roller_angle="${-pi/4}"/>
  <xacro:mecanum_wheel name="wheel_rear_left"   parent="base_link"
                        x="${-lx}" y="${ly}"  roller_angle="${-pi/4}"/>
  <xacro:mecanum_wheel name="wheel_rear_right"  parent="base_link"
                        x="${-lx}" y="${-ly}" roller_angle="${pi/4}"/>

  <!-- ============================================================ -->
  <!-- Sensors                                                       -->
  <!-- ============================================================ -->

  <!-- IMU -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${base_height + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR -->
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="0 0 ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ToF sensor (front-facing, on chassis front edge) -->
  <link name="tof_link"/>
  <joint name="tof_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="tof_link"/>
    <origin xyz="${base_length/2 - 0.01} 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length/2 - 0.02} 0 ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- ros2_control                                                  -->
  <!-- ============================================================ -->
  <ros2_control name="MCRSystem" type="system">
    <hardware>
      <plugin>mcr_bringup/MCRHardwareInterface</plugin>
      <param name="serial_device">/dev/ttyAMA0</param>
      <param name="serial_baud">921600</param>
      <param name="wheel_radius">${wheel_radius}</param>
      <param name="lx">${lx}</param>
      <param name="ly">${ly}</param>
    </hardware>

    <!-- 4 velocity-controlled wheel joints -->
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface    name="position"/>
      <state_interface    name="velocity"/>
    </joint>
    <joint name="wheel_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface    name="position"/>
      <state_interface    name="velocity"/>
    </joint>
    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface    name="position"/>
      <state_interface    name="velocity"/>
    </joint>
    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface    name="position"/>
      <state_interface    name="velocity"/>
    </joint>

    <!-- Sensors -->
    <sensor name="imu_sensor">
      <state_interface name="orientation.w"/>
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <param name="frame_id">imu_link</param>
    </sensor>

    <sensor name="tof_sensor">
      <state_interface name="range"/>
      <param name="frame_id">tof_link</param>
    </sensor>
  </ros2_control>

</robot>
