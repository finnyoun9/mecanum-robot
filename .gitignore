# Build artifacts
build/
build-handoff/
bin/
obj/
*.o
*.a
*.elf
*.hex
*.bin

# ROS2
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# STM32
# firmware/Core/Drivers, firmware/Core/Middleware ARE committed (not
# ignored): there's no CubeMX .ioc in this project, so unlike a typical
# CubeMX-generated tree, vendored HAL/CMSIS/FreeRTOS can't be regenerated
# on clone. The *.o/*.elf/*.bin patterns above already cover firmware/Core/HW's
# build output.
*.ioc
*.mxproject

# Python
__pycache__/
*.pyc
.venv/

# Perception outputs (large generated files)
perception/**/*.ply
perception/**/*.pcd
perception/**/scan_output.*

# OS
.DS_Store
Thumbs.db

# SLAM 建图产物（体积大且易变，按需本地生成）
maps/*.pgm
ros2_ws/maps/
